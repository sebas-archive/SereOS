+/* ---- sintesis (S16 mono 22050, callback con mezcla bucle+one-shot) -- */
+static uint32_t synth_phase_inc(int freq)
+{
+	/* salida = rate * inc / 65536  =>  inc = freq * 65536 / rate */
+	if (freq <= 0)
+		return 0;
+	return (uint32_t)(((uint64_t)(uint32_t)freq << 16) / PAC_AUDIO_RATE);
+}
